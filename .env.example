# Copy to apps/api/.env (never commit the real file). Secrets are server-side only.
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Database (Supabase/Postgres). Use pooled URL for runtime, direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# TLS is verified for non-local hosts. Paste the Supabase CA certificate (PEM, \n-escaped) here:
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
OTP_HMAC_SECRET=
# AES-256-GCM key for PAN / bank account at rest: openssl rand -base64 32 (mandatory in production; losing it makes stored values unreadable)
FIELD_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Admin bootstrap (first run only; change immediately)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Providers — all disabled unless explicitly enabled and verified
EMAIL_PROVIDER=console        # console | zeptomail
ZEPTOMAIL_SEND_MAIL_TOKEN=
EMAIL_FROM_ADDRESS=support@techartha.com
EMAIL_FROM_NAME=TechArtha
ZEPTOMAIL_API_BASE=https://api.zeptomail.in   # India data centre; use https://api.zeptomail.com for .com accounts
EMAIL_TIMEOUT_MS=8000
EMAIL_RETRY_BASE_MS=300

OTP_SMS_PROVIDER=disabled     # disabled | interakt | mtalkz
INTERAKT_API_KEY=
INTERAKT_OTP_TEMPLATE_NAME=
MTALKZ_API_KEY=

# Cybrilla / Fintech Primitives — sandbox only until production approval
CYBRILLA_ENV=sandbox
CYBRILLA_BASE_URL=
CYBRILLA_TENANT_ID=
CYBRILLA_CLIENT_ID=
CYBRILLA_CLIENT_SECRET=
CYBRILLA_WEBHOOK_SECRET=

MFAPI_BASE=https://api.mfapi.in

# Tests only (throwaway database, NEVER production/staging data): TEST_DATABASE_URL=postgresql://postgres@localhost:5432/ta_test
# THROTTLE_DISABLED=true is for automated tests only; the API refuses to start with it in production.

# Admin portal (server-side only): URL the Next.js server uses to reach the API
API_INTERNAL_URL=http://localhost:3000

# Mobile (public values only — NEVER put secrets in EXPO_PUBLIC_*)
EXPO_PUBLIC_API_URL=http://localhost:3000
