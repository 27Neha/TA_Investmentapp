{
  "name": "techartha-investment-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w apps/api",
    "api:test": "npm test -w apps/api",
    "api:build": "npm run build -w apps/api",
    "mobile:start": "npm run start -w apps/mobile",
    "admin:dev": "npm run dev -w apps/admin",
    "lint": "eslint .",
    "lint:api": "eslint apps/api",
    "lint:mobile": "eslint apps/mobile",
    "lint:admin": "eslint apps/admin",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
